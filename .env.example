# Local mode runs without any API key.
TRIPMIND_MODE=local

# Alibaba Cloud Model Studio (Bailian / DashScope)
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-plus

# Optional: paste the One-Key Amap Maps MCP endpoint/config from Bailian MCP Marketplace.
# The initial scaffold keeps this as an explicit adapter boundary.
AMAP_MCP_URL=
