# Offline defaults: no API key is required.
TRIPMIND_MODE=local

# Routing: auto | local | ors
# auto uses ORS when ORS_API_KEY is set, otherwise the local estimate.
TRIPMIND_ROUTE_PROVIDER=auto
ORS_API_KEY=
ORS_BASE_URL=https://api.openrouteservice.org

# Realtime context: auto | local | dashscope
# auto uses Alibaba Cloud web search when DASHSCOPE_API_KEY is set.
TRIPMIND_REALTIME_PROVIDER=auto
TRIPMIND_REALTIME_TTL_SECONDS=3600
TRIPMIND_REALTIME_POI_LIMIT=6

# Alibaba Cloud Model Studio / Qwen
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-plus
DASHSCOPE_REALTIME_MODEL=qwen-plus
DASHSCOPE_SEARCH_STRATEGY=turbo

# Reserved for a future China-specific route provider if needed.
AMAP_MCP_URL=
