# Environment variables are optional and override YAML values.
# Recommended secret locations:
#   1) configs/config.local.yaml
#   2) .env
# Never commit real API keys.

TRIPMIND_CONFIG=configs/config.yaml

# Routing: auto | local | ors
TRIPMIND_ROUTE_PROVIDER=auto
ORS_API_KEY=
ORS_BASE_URL=https://api.heigit.org/openrouteservice

# Realtime context: auto | local | dashscope
TRIPMIND_REALTIME_PROVIDER=auto
TRIPMIND_REALTIME_TTL_SECONDS=3600
TRIPMIND_REALTIME_POI_LIMIT=6

# Alibaba Cloud Model Studio / Qwen
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-plus
DASHSCOPE_REALTIME_MODEL=qwen-plus
DASHSCOPE_SEARCH_STRATEGY=turbo
